// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  pelamar
}

enum JobType {
  FullTime
  PartTime
  Internship
  Freelance
  Contract
}

enum ExperienceLevel {
  FreshGraduate
  Junior
  MidLevel
  Senior
}

enum EducationLevel {
  SMA 
  D3
  D4
  S1
  S2
  S3
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(pelamar)
  createdAt    DateTime      @default(now())
  applications Application[]

  profile      Profile?
}


model Profile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  fullName      String?
  NIK           String?
  gender        String?
  nomorHp       String?
  tempatLahir   String?
  tanggalLahir  DateTime?
  alamat        String?
  fotoProfile   String? @db.LongText
  about         String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Job {
  id           Int           @id @default(autoincrement())
  title        String
  department   String?
  location     String?
  type         JobType?
  experience   ExperienceLevel?
  education    EducationLevel?
  // Gunakan atribut @db.Text agar kapasitasnya besar (65,535 karakter)
  description  String?       @db.Text 
  requirements String?       @db.Text
  deadline     DateTime?
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  applications Application[]
}
model Application {
  id            Int       @id @default(autoincrement())
  userId        Int
  jobId         Int
  cvUrl         String
  portfolioUrl  String?
  status        String    @default("under-review")
  stage         String    @default("Under Review")
  score         Int?
  appliedAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  job           Job       @relation(fields: [jobId], references: [id])
}

model Reports {
  id                Int       @id @default(autoincrement())
  period            String
  startDate         DateTime
  endDate           DateTime
  totalApplications Int       @default(0)
  accepted          Int       @default(0)
  rejected          Int       @default(0)
  averageProcessTime Float?
  conversionRate    Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  positionDetails   Json?
}
