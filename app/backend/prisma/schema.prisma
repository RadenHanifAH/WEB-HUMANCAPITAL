// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  pelamar
}

enum JobType {
  FullTime
  PartTime
  Internship
  Freelance
  Contract
}

enum ExperienceLevel {
  FreshGraduate
  Junior
  MidLevel
  Senior
}

enum EducationLevel {
  SMA 
  D3
  D4
  S1
  S2
  S3
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(pelamar)
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Job {
  id             Int             @id @default(autoincrement())
  title          String
  department     String?
  location       String?
  type           JobType?
  experience     ExperienceLevel?
  education      EducationLevel?
  description    String?
  requirements   String?
  deadline       DateTime?
  status         String          @default("open")
  createdAt      DateTime        @default(now())
  applications   Application[]
}

model Application {
  id            Int       @id @default(autoincrement())
  userId        Int
  jobId         Int
  cvUrl         String
  portfolioUrl  String?
  status        String    @default("Under Review")
  appliedAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
  job           Job       @relation(fields: [jobId], references: [id])
}
